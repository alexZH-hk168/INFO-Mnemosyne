{
  "name": "mnemosyne-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5170 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5170 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:gen": "tsx scripts/gen-fixtures.ts",
    "check:fixtures": "tsx scripts/check-fixtures.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:fixtures",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.108.2",
    "framer-motion": "^11.18.2",
    "katex": "^0.16.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.58.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "ts-json-schema-generator": "^2.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
