      "source_url": "https://github.com/tavily-ai/tavily-mcp",
      "license": "MIT",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.2.22"
      ],
      "env_schema": {
        "TAVILY_API_KEY": {
          "required": true,
          "secret": true,
          "label": "Tavily API Key"
        }
      },
      "permissions": [
        "network"
      ],
      "tools_allow": [
        "tavily-search",
        "tavily-extract"
      ],
      "evidence_mapping": {
        "items": "$.results",
        "title": "$.title",
        "url": "$.url",
        "quote": "$.content"
      }
    },
    "tools": [
      {
        "name": "tavily-search",
        "description": "实时网页检索"
      },
      {
        "name": "tavily-extract",
        "description": "抽取指定网页的正文"
      }
    ],
    "permission_notes": {
      "network": "访问 Tavily API"
    }
  },
