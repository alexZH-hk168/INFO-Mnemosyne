    "category": "网页检索与抓取",
    "desc_zh": "搜索网页并提取正文做资料摘录",
    "repo_url": "https://github.com/tavily-ai/tavily-mcp",
    "verified": false,
    "short_name": "Tavily 检索",
    "manifest": {
      "id": "tavily",
